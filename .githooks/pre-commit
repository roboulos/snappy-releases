#!/usr/bin/env bash
# Five checks, then the pre-commit framework when that command exists.
# The five tools run together and must finish in under 2 seconds.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail

die() {
	printf '%s\n' "$1" >&2
	exit 1
}

need() {
	command -v "$1" >/dev/null 2>&1 || die "$1 not found"
}

show_logs() {
	if [[ -s "$2" ]]; then
		cat "$2" >&2
	fi
	if [[ -s "$1" ]]; then
		cat "$1"
	fi
}

need git
need mergify
need shfmt
need shellcheck
need actionlint
need python3
need curl

root="$(git rev-parse --show-toplevel)"
cd "${root}" || die "cannot enter ${root}"

ste_sha="66c454b94dea0f81334f36b222775b62b6ec24e25c0e62308f23c550ef3eaa3d"
ste_url="https://raw.githubusercontent.com"
ste_url+="/danyuchn/asd-ste100-skill"
ste_url+="/65c8ab6ef5fcb3619c8e6daca43e68627f3d7b4a"
ste_url+="/scripts/ste-lint.py"
ste_cache="${XDG_CACHE_HOME:-${HOME}/.cache}/snappy-releases/ste-lint.py"
ste_known="${HOME}/.cache/ste-lint/65c8ab6ef5fcb3619c8e6daca43e68627f3d7b4a/ste-lint.py"

ste_match() {
	[[ -f "$1" ]] || return 1
	python3 -c '
import hashlib, sys
p = sys.argv[1]
d = open(p, "rb").read()
h = hashlib.sha256(d).hexdigest()
raise SystemExit(0 if h == sys.argv[2] else 1)
' "$1" "${ste_sha}"
}

pick_ste() {
	ste_lint=""
	ste_status=1
	if [[ -f "${ste_known}" ]]; then
		set +e
		ste_match "${ste_known}"
		ste_status=$?
		set -e
	fi
	if [[ "${ste_status}" -eq 0 ]]; then
		ste_lint="${ste_known}"
		return 0
	fi
	ste_status=1
	if [[ -f "${ste_cache}" ]]; then
		set +e
		ste_match "${ste_cache}"
		ste_status=$?
		set -e
	fi
	if [[ "${ste_status}" -eq 0 ]]; then
		ste_lint="${ste_cache}"
		return 0
	fi
	mkdir -p "$(dirname "${ste_cache}")"
	tmp="$(mktemp)"
	curl -fsSL --retry 2 --output "${tmp}" "${ste_url}" || die "could not download ste-lint.py"
	set +e
	ste_match "${tmp}"
	ste_status=$?
	set -e
	if [[ "${ste_status}" -ne 0 ]]; then
		rm -f "${tmp}"
		die "ste-lint.py checksum mismatch"
	fi
	mv "${tmp}" "${ste_cache}"
	ste_lint="${ste_cache}"
}

pick_ste

stamp_dir="$(mktemp -d)"
trap 'rm -rf "${stamp_dir}"' EXIT
python3 -c 'import time; print("%.6f" % time.perf_counter())' >"${stamp_dir}/start"

shfmt -f . >"${stamp_dir}/shell"
if [[ ! -s "${stamp_dir}/shell" ]]; then
	die "no shell files found"
fi
shell_files=()
while IFS= read -r shell_file; do
	shell_files+=("${shell_file}")
done <"${stamp_dir}/shell"

git ls-files '*.md' >"${stamp_dir}/docs"
if [[ ! -s "${stamp_dir}/docs" ]]; then
	die "no Markdown files found"
fi
doc_files=()
while IFS= read -r doc_file; do
	doc_files+=("${doc_file}")
done <"${stamp_dir}/docs"

mergify config validate -f .mergify.yml >"${stamp_dir}/mergify.out" 2>"${stamp_dir}/mergify.err" &
pid_mergify=$!
shfmt -d "${shell_files[@]}" >"${stamp_dir}/shfmt.out" 2>"${stamp_dir}/shfmt.err" &
pid_shfmt=$!
shellcheck --enable=all -x "${shell_files[@]}" \
	>"${stamp_dir}/shellcheck.out" \
	2>"${stamp_dir}/shellcheck.err" &
pid_shellcheck=$!
actionlint -color >"${stamp_dir}/actionlint.out" 2>"${stamp_dir}/actionlint.err" &
pid_actionlint=$!
python3 -I "${ste_lint}" "${doc_files[@]}" >"${stamp_dir}/ste.out" 2>"${stamp_dir}/ste.err" &
pid_ste=$!

set +e
wait "${pid_mergify}"
st_mergify=$?
wait "${pid_shfmt}"
st_shfmt=$?
wait "${pid_shellcheck}"
st_shellcheck=$?
wait "${pid_actionlint}"
st_actionlint=$?
wait "${pid_ste}"
st_ste=$?
set -e

python3 -c 'import time; print("%.6f" % time.perf_counter())' >"${stamp_dir}/end"

ok=1
if [[ "${st_mergify}" -ne 0 ]]; then
	show_logs "${stamp_dir}/mergify.out" "${stamp_dir}/mergify.err"
	printf '%s\n' "mergify config validate failed" >&2
	ok=0
fi
if [[ "${st_shfmt}" -ne 0 ]]; then
	show_logs "${stamp_dir}/shfmt.out" "${stamp_dir}/shfmt.err"
	printf '%s\n' "shfmt failed" >&2
	ok=0
fi
if [[ "${st_shellcheck}" -ne 0 ]]; then
	show_logs "${stamp_dir}/shellcheck.out" "${stamp_dir}/shellcheck.err"
	printf '%s\n' "shellcheck failed" >&2
	ok=0
fi
if [[ "${st_actionlint}" -ne 0 ]]; then
	show_logs "${stamp_dir}/actionlint.out" "${stamp_dir}/actionlint.err"
	printf '%s\n' "actionlint failed" >&2
	ok=0
fi
if [[ "${st_ste}" -ne 0 ]]; then
	show_logs "${stamp_dir}/ste.out" "${stamp_dir}/ste.err"
	printf '%s\n' "ASD-STE100 linter failed" >&2
	ok=0
fi
if [[ "${ok}" -eq 0 ]]; then
	die "a check failed"
fi

show_logs "${stamp_dir}/mergify.out" "${stamp_dir}/mergify.err"
show_logs "${stamp_dir}/shfmt.out" "${stamp_dir}/shfmt.err"
show_logs "${stamp_dir}/shellcheck.out" "${stamp_dir}/shellcheck.err"
show_logs "${stamp_dir}/actionlint.out" "${stamp_dir}/actionlint.err"
show_logs "${stamp_dir}/ste.out" "${stamp_dir}/ste.err"

python3 -c 'import sys
start=float(open(sys.argv[1]).read())
end=float(open(sys.argv[2]).read())
elapsed=end-start
sys.stderr.write("five checks: %.3fs\n" % elapsed)
raise SystemExit(0 if elapsed < 2 else 1)' \
	"${stamp_dir}/start" "${stamp_dir}/end" ||
	die "the five checks took 2 seconds or more"

rm -rf "${stamp_dir}"
trap - EXIT

if command -v pre-commit >/dev/null 2>&1; then
	here="$(cd "$(dirname "$0")" && pwd)"
	exec pre-commit hook-impl \
		--config=.pre-commit-config.yaml \
		--hook-type=pre-commit \
		--hook-dir "${here}" -- "$@"
fi
